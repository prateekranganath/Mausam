# --- secrets ---------------------------------------------------------------
# Real keys live here; .env.example (tracked) documents the variables.
.env

# --- python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- editors / OS / tooling ------------------------------------------------
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- logs ------------------------------------------------------------------
*.log

# --- data ------------------------------------------------------------------
# The raw dataset is large and kept locally (never modified in place).
Data/india_weather_rainfall_data.xlsx
# Everything derived from it, plus every upstream response cache:
#   open_meteo_cache/     forecast_*.json, history_*.json
#   power_cache/          one NASA POWER shard per district (the 11-year
#                         daily backfill; regenerate with
#                         scripts/build_power_dataset.py, which is resumable)
#   climate_index_cache/  ONI, DMI and MJO RMM feeds
# All regenerable, so none of it is committed. The API needs no local
# dataset: /historical, the monsoon detectors and the climate context all
# fetch and cache on demand.
Data/processed/

# --- trained model artifacts -----------------------------------------------
# Binary artifacts live on Hugging Face and are reproducible with
# scripts/train_model.py / scripts/train_all_india_model.py. The small
# metadata, evaluation JSON and model cards stay tracked because they diff
# well and document what was trained.
models/**/*.joblib
models/**/plots/
