HF_TOKEN=
HF_USERNAME=neollm007
OPENROUTER_API_KEY=
# Optional. /advisory ALWAYS returns a complete rule-based analysis; OpenRouter
# only adds a 2-3 sentence plain-language note over it. A key alone is enough:
# a default chain of free models is used.
#
# The chain is OPENROUTER_MODEL first, then OPENROUTER_FALLBACK_MODELS in order.
# A model that fails (503 overloaded, 429, truncated or off-task reply) is
# skipped for a minute and the next is tried. Free-tier availability changes by
# the hour; measured 2026-09-21, nex-n2.5-mini and laguna-xs answered while
# Gemma, GLM and Qwen returned 429, and Nemotron flipped between working and
# 503. Put whichever is answering best today first.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Comma-separated. Leave unset for the defaults (laguna-xs, gemma-4-26b,
# nex-n2.5-mini, all :free); set it empty to disable fallbacks.
# OPENROUTER_FALLBACK_MODELS=poolside/laguna-xs-2.1:free,nex-agi/nex-n2.5-mini:free
# Per model attempt, and for the whole chain. The total is what bounds the wait.
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_TOTAL_BUDGET_SECONDS=40

# Comma-separated origins allowed to call the API from a browser
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RAINFALL_RISK_THRESHOLD_PERCENTILE=33
DEFAULT_DISTRICT=Thiruvananthapuram

# Telegram alert delivery (Messaging/send_telegram.py). Create a bot with
# @BotFather to get the token; TELEGRAM_CHAT_ID is the default recipient
# when send_monsoon_alert() is called without an explicit chat_id.
# Both are optional: nothing else in the project reads them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
