HF_TOKEN=
HF_USERNAME=neollm007
OPENROUTER_API_KEY=
# Free model verified to work as a plain API client with structured output
# and to finish in ~20s. Others tested: nvidia/nemotron-3-ultra-550b-a55b:free
# works but takes ~75s; nvidia/nemotron-3.5-lightning:free takes ~190s;
# thinkingmachines/inkling(-small):free return HTTP 403 (agentic harnesses only).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Free models are sometimes slow or overloaded; raise this for slower ones.
OPENROUTER_TIMEOUT_SECONDS=90

# Comma-separated origins allowed to call the API from a browser
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

RAINFALL_RISK_THRESHOLD_PERCENTILE=33
DEFAULT_DISTRICT=Thiruvananthapuram
